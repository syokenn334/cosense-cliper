{
  "manifest_version": 3,
  "name": "Cosense Clip",
  "version": "0.2.10",
  "minimum_chrome_version": "120",
  "description": "Web・YouTube・Xを、タブを開かずCosenseへクリップ。",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://scrapbox.io/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Cosenseにクリップ" },
  "options_page": "options.html",
  "content_scripts": [{
    "matches": ["https://www.youtube.com/*", "https://x.com/*", "https://twitter.com/*"],
    "js": ["keyboard.js"],
    "run_at": "document_start"
  }, {
    "matches": ["https://www.youtube.com/*", "https://x.com/*", "https://twitter.com/*"],
    "js": ["extract.js", "content.js"],
    "run_at": "document_idle"
  }]
}
